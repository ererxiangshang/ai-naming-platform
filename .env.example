# ===== Supabase =====
SUPABASE_URL=你的supabase项目地址
SUPABASE_ANON_KEY=你的supabase匿名密钥

# ===== 模型密钥（按需填写，至少填一个）=====
# 豆包 / 火山方舟
DOUBAO_API_KEY=你的火山方舟密钥
# 豆包模型名或推理接入点 ID（ep-xxxx）
DOUBAO_MODEL=doubao-seed-1-6-250615
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v1

# DeepSeek
DEEPSEEK_API_KEY=你的deepseek密钥
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 DashScope（必须用 compatible-mode 地址）
QWEN_API_KEY=你的dashscope密钥
QWEN_MODEL=qwen-plus

# Kimi / 月之暗面
KIMI_API_KEY=你的moonshot密钥
KIMI_MODEL=kimi-k3.1-pro
